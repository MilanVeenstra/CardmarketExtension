{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Cart Saver",
  "description": "__MSG_extDescription__",
  "version": "1.4.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "https://www.cardmarket.com/*",
    "https://downloads.s3.cardmarket.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Cart Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/*"
      ],
      "js": [
        "src/page/bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.cardmarket.com/*"
      ],
      "js": [
        "src/shared/i18n.js",
        "src/shared/store.js",
        "src/shared/ui.js",
        "src/content/cardmarket.js",
        "src/content/refill.js",
        "src/content/replace.js",
        "src/content/widget.js",
        "src/content/favorites.js",
        "src/content/thumbs.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
